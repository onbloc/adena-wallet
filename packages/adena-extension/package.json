{
  "name": "adena-extension",
  "version": "1.22.5",
  "private": true,
  "description": "Adena is a friendly browser extension wallet for the Gno.land blockchain.",
  "type": "module",
  "scripts": {
    "dev": "vite build --mode development --watch",
    "dev:firefox": "vite build --mode development --watch -- --browser=firefox",
    "build": "pnpm typecheck && vite build",
    "build:firefox": "pnpm typecheck && vite build -- --browser=firefox",
    "smoke": "node scripts/smoke-bundle.mjs",
    "typecheck": "node ./node_modules/typescript-native/bin/tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "test:ci": "vitest --run",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build"
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@ledgerhq/hw-transport": "6.35.5",
    "@rolldown/plugin-node-polyfills": "1.0.4",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-links": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/chrome": "0.3.7",
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/wicg-file-system-access": "2023.10.7",
    "@types/zxcvbn": "4.4.5",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-storybook": "10.6.6",
    "jsdom": "31.0.0",
    "libsodium-wrappers-sumo": "0.8.4",
    "storybook": "10.6.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "8.3.6",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@adena-wallet/sdk": "0.1.3",
    "@bufbuild/protobuf": "2.17.0",
    "@cosmjs/amino": "0.39.0",
    "@cosmjs/encoding": "0.39.0",
    "@cosmjs/proto-signing": "0.39.0",
    "@gnolang/gno-js-client": "3.1.0",
    "@gnolang/tm2-js-client": "3.3.0",
    "@gnolang/tm2-rpc": "2.0.2",
    "@tanstack/react-query": "5.107.1",
    "adena-module": "workspace:*",
    "axios": "1.21.0",
    "bignumber.js": "11.1.5",
    "cosmjs-types": "0.11.0",
    "dayjs": "1.11.23",
    "jotai": "3.0.2",
    "jotai-family": "1.1.0",
    "lodash": "4.18.1",
    "lottie-web": "5.13.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-idle-timer": "5.7.3",
    "react-router": "8.5.1",
    "styled-components": "6.6.0",
    "uuid": "14.0.3",
    "zxcvbn": "4.4.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": "eslint --fix"
  }
