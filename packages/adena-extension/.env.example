# Web3Auth verifier values for social login.
#
# Copy to `.env` for local development. CI injects the same names as repository
# secrets, and real environment variables take precedence over this file.
#
# Every value here is a public identifier: it ships inside the extension bundle
# and is readable by anyone who unpacks it. Access is gated by the allowed
# origins configured on the Web3Auth, Google and Auth0 dashboards.
#
# A provider whose values are missing is skipped at runtime - its sign-in screen
# goes straight to the failure step instead of opening a login popup.

# --- Google (legacy) ---------------------------------------------------------
# Accounts created before the production verifier can only be reached through
# this one, so it stays selectable. Falls back to the values hardcoded in
# src/common/constants/web3auth.constant.ts when left empty.
WEB3_AUTH_LEGACY_CLIENT_ID=""
GOOGLE_LEGACY_VERIFIER=""
GOOGLE_LEGACY_CLIENT_ID=""

# --- Google (production) -----------------------------------------------------
# Used for new accounts.
WEB3_AUTH_PRODUCTION_CLIENT_ID=""
GOOGLE_PRODUCTION_VERIFIER=""
GOOGLE_PRODUCTION_CLIENT_ID=""

# --- Email (passwordless) ----------------------------------------------------
WEB3_AUTH_EMAIL_CLIENT_ID=""
EMAIL_VERIFIER_NAME=""
EMAIL_CLIENT_ID=""
EMAIL_AUTH0_DOMAIN=""

# --- X -----------------------------------------------------------------------
# Web3Auth reaches X through an Auth0 JWT verifier, so this one also needs the
# Auth0 domain. Without it the X sign-in screen reports a failure.
WEB3_AUTH_X_CLIENT_ID=""
X_VERIFIER_NAME=""
X_CLIENT_ID=""
X_AUTH0_DOMAIN=""
