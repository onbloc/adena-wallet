{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": [
      "node",
      "@types/react",
      "@types/react-dom",
      "@types/chrome",
      "wicg-file-system-access",
      "vitest/globals",
      "vite/client",
      "@crxjs/vite-plugin/client"
    ],
    "sourceMap": false,
    "paths": {
      "@public/manifest.json": [
        "./manifest.json"
      ],
      "@types": [
        "./src/types"
      ],
      "@states": [
        "./src/states"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@ui/*": [
        "./src/ui/*"
      ],
      "@pages/*": [
        "./src/pages/*"
      ],
      "@router/*": [
        "./src/router/*"
      ],
      "@services/*": [
        "./src/services/*"
      ],
      "@repositories/*": [
        "./src/repositories/*"
      ],
      "@resources/*": [
        "./src/resources/*"
      ],
      "@styles/*": [
        "./src/styles/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@common/*": [
        "./src/common/*"
      ],
      "@inject/*": [
        "./src/inject/*"
      ],
      "@assets/*": [
        "./src/assets/*"
      ],
      "@migrates/*": [
        "./src/migrates/*"
      ],
      "@models/*": [
        "./src/models/*"
      ],
      "@public/*": [
        "./public/*"
      ]
    },
    "noEmit": true
  },
  "include": [
    "./src/**/*",
    "./vite.config.ts",
    "./vitest.config.ts",
    "./vitest.setup.ts",
    "./manifest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-firefox"
  ]
}
