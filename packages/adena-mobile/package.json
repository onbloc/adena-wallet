{
  "name": "adena-mobile",
  "version": "0.0.1",
  "private": true,
  "description": "Adena mobile wallet for iOS and Android.",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "bundle:check": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output /tmp/adena-mobile.ios.jsbundle --assets-dest /tmp/adena-mobile-assets",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "jest",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build -o storybook-static",
    "test:ci": "jest --ci",
    "test:coverage": "jest --coverage",
    "e2e": "bash e2e/run.sh",
    "e2e:smoke": "bash e2e/run.sh --include-tags smoke"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.123",
    "@cfworker/json-schema": "4.1.6",
    "@cosmjs/amino": "0.39.0",
    "@cosmjs/crypto": "0.39.0",
    "@cosmjs/encoding": "0.39.0",
    "@gnolang/gno-js-client": "3.1.0",
    "@gnolang/tm2-js-client": "3.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@react-native-ai/llama": "0.13.0",
    "@react-native-clipboard/clipboard": "1.16.3",
    "@react-navigation/bottom-tabs": "7.22.0",
    "@react-navigation/native": "7.5.2",
    "@react-navigation/native-stack": "7.21.1",
    "@stardazed/streams-text-encoding": "1.0.2",
    "@tanstack/react-query": "5.107.1",
    "@ungap/structured-clone": "1.4.0",
    "adena-ai-llm-poc": "link:../adena-ai",
    "ai": "7.0.179",
    "bignumber.js": "11.1.5",
    "buffer": "6.0.3",
    "cosmjs-types": "0.11.0",
    "llama.rn": "0.13.0-rc.12",
    "lucide-react-native": "1.73.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-blob-util": "0.24.13",
    "react-native-get-random-values": "2.1.0",
    "react-native-haptic-feedback": "3.0.0",
    "react-native-image-picker": "8.3.0",
    "react-native-keychain": "11.0.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.2",
    "react-native-qrcode-svg": "6.3.54",
    "react-native-quick-base64": "3.0.1",
    "react-native-quick-crypto": "1.1.9",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-vision-camera": "5.2.4",
    "react-native-vision-camera-barcode-scanner": "5.2.4",
    "web-streams-polyfill": "4.5.1",
    "zod": "4.6.7",
    "zustand": "5.1.0",
    "zxcvbn": "4.4.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@babel/preset-env": "7.29.14",
    "@babel/runtime": "7.29.14",
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/assets-registry": "0.88.1",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/codegen": "0.88.1",
    "@react-native/gradle-plugin": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@storybook/react": "10.6.7",
    "@storybook/react-native-web-vite": "10.6.7",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "@types/zxcvbn": "4.4.5",
    "adena-module": "link:../adena-module",
    "eslint": "10.14.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "hermes-compiler": "260318099.0.5",
    "jest": "29.7.0",
    "react-dom": "19.3.0",
    "react-native-svg-transformer": "1.5.3",
    "react-native-web": "0.21.4",
    "storybook": "10.6.7",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-svgr": "5.2.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": "eslint --fix"
  },
  "codegenConfig": {
    "name": "AdenaMobileSpecs",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.adena.specs"
    },
    "ios": {
      "modulesProvider": {
        "AdenaCloudBackup": "AdenaCloudBackup",
        "AdenaSecureClipboard": "AdenaSecureClipboard"
      }
    }
  },
  "packageManager": "pnpm@11.28.11"
}
