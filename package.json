{
  "name": "adena-wallet",
  "version": "1.22.2",
  "description": "Adena Wallet",
  "license": "Adena License",
  "private": true,
  "scripts": {
    "setup": "yarn install && yarn allow-scripts",
    "develop": "yarn workspace adena-extension build:dev",
    "develop:firefox": "yarn workspace adena-extension build:firefox:dev",
    "build": "yarn build:module && yarn build:service && yarn",
    "build:module": "yarn workspace adena-module build",
    "build:service": "yarn workspace adena-extension build",
    "build:firefox": "yarn build:module && yarn workspace adena-extension build:firefox",
    "version:qa": "sh scripts/update-build-version.sh",
    "version:package": "sh scripts/update-package-version.sh",
    "tag": "sh scripts/create-tag.sh",
    "test": "jest --passWithNoTests"
  },
  "resolutions": {
    "@storybook/react-docgen-typescript-plugin": "npm:react-docgen-typescript-plugin@1.0.5",
    "webpack-dev-middleware": "7.4.6",
    "postcss": "8.5.28",
    "serialize-javascript@^6.0.2": "7.1.2",
    "tar@^6.0.5": "7.5.22",
    "tar@^6.1.11": "7.5.22",
    "tar@^6.2.1": "7.5.22",
    "uuid@^8.3.2": "11.1.1",
    "uuid@^9.0.0": "11.1.1",
    "ws": "8.22.0",
    "@bufbuild/protobuf": "2.15.0",
    "@gnolang/tm2-js-client": "3.3.0",
    "@gnolang/tm2-rpc": "2.0.2",
    "@cosmjs/amino": "0.39.0",
    "@cosmjs/crypto": "0.39.0",
    "@cosmjs/ledger-amino": "0.39.0",
    "@cosmjs/proto-signing": "0.39.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@lavamoat/allow-scripts": "3.0.3",
    "@lavamoat/preinstall-always-fail": "2.0.0",
    "@yarnpkg/sdks": "3.1.0",
    "babel-loader": "9.1.3",
    "eslint": "8.56.0",
    "file-loader": "6.2.0",
    "husky": "9.0.11",
    "jest": "29.7.0",
    "lint-staged": "15.4.3",
    "prettier": "3.2.5",
    "tsconfig-paths-webpack-plugin": "4.1.0",
    "typescript": "4.9.5"
  },
  "workspaces": [
    "packages/*"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "git add"
    ]
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false,
      "@storybook/react>@storybook/docs-tools>@storybook/core-common>esbuild": false
    }
  },
  "packageManager": "yarn@4.9.2"
}
